---
// Illustrative Vorschau der App (Beispieldaten, kein Screenshot).
const persons = [
  { name: 'Beck', firstName: 'Anna', active: true, groups: 'Harmoniemusik' },
  { name: 'Frick', firstName: 'Luca', active: true, groups: 'Harmoniemusik' },
  { name: 'Kaiser', firstName: 'Mia', active: false, groups: 'Ehrenmitglied' },
  { name: 'Wolf', firstName: 'Jonas', active: true, groups: 'Jugendmusik' },
];
const filters = [
  { label: 'Status', placeholder: 'Status wählen' },
  { label: 'Vereinsgruppen', placeholder: 'Vereinsgruppen wählen' },
  { label: 'Aktivmitglied', placeholder: 'Aktivmitglied wählen' },
];
const menu = ['Anlässe', 'Personen', 'Organisationen', 'Instrumente', 'Uniformen', 'Notenarchiv', 'Administration'];
---
<div class="preview" role="img" aria-label="Vorschau der Vereinsordner-App mit einer Personenliste">
  <div class="backdrop" aria-hidden="true"></div>

  <div class="window" aria-hidden="true">
    <div class="titlebar">
      <div class="dots"><span></span><span></span><span></span></div>
      <div class="url">app.vereinsordner.li</div>
    </div>
    <div class="body">
      <div class="sidebar">
        {menu.map((m) => <span class:list={{ active: m === 'Personen' }}>{m}</span>)}
      </div>
      <div class="main">
        <div class="main-head">
          <span class="main-title">Personen</span>
          <span class="new">+ Neue Person</span>
        </div>

        <div class="filters">
          <div class="field search">
            <span class="label">Suche</span>
            <span class="input">Name oder Vorname</span>
          </div>
          {filters.map((f) => (
            <div class="field">
              <span class="label">{f.label}</span>
              <span class="input select">
                <span class="placeholder">{f.placeholder}</span>
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </span>
            </div>
          ))}
        </div>

        <div class="table-wrap">
          <div class="table">
            <div class="row head">
              <span>Name ▲</span><span>Vorname</span><span>Aktivmitglied</span><span>Vereinsgruppen</span>
            </div>
            {persons.map((p) => (
              <div class="row">
                <span class="name">{p.name}</span>
                <span>{p.firstName}</span>
                <span class:list={['pill', { passive: !p.active }]}>{p.active ? 'Ja' : 'Nein'}</span>
                <span class="groups">{p.groups}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .preview { flex: 1 1 520px; min-width: 0; position: relative; }
  .backdrop {
    position: absolute; top: -28px; right: -28px; width: 70%; height: 80%;
    border-radius: 32px; background: var(--c-tint);
  }
  .window {
    position: relative; border-radius: 16px; background: #fff; overflow: hidden;
    border: 1px solid var(--c-border); box-shadow: 0 24px 60px rgb(65 36 2 / 0.14);
  }
  .titlebar {
    display: flex; align-items: center; gap: 12px; padding: 12px 16px;
    background: #fbf4e8; border-bottom: 1px solid var(--c-border);
  }
  .dots { display: flex; gap: 6px; }
  .dots span { width: 10px; height: 10px; border-radius: 50%; background: #e2cfae; }
  .url {
    flex: 1; text-align: center; font-size: 12px; color: var(--c-text-muted);
    background: #fff; border: 1px solid var(--c-border); border-radius: 6px; padding: 4px 10px;
  }
  .body { display: flex; min-height: 340px; }
  .sidebar {
    width: 150px; flex-shrink: 0; background: var(--c-dark); color: var(--c-on-dark);
    padding: 18px 12px; display: flex; flex-direction: column; gap: 4px;
    font-size: 13px; font-weight: 600;
  }
  .sidebar span { padding: 8px 10px; border-radius: 8px; }
  .sidebar .active { background: var(--c-orange); color: var(--c-dark); }
  .main { flex: 1; min-width: 0; padding: 20px; display: flex; flex-direction: column; gap: 14px; }
  .main-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .main-title { font-size: 18px; font-weight: 800; color: var(--c-dark); }
  .new {
    font-size: 12px; font-weight: 700; padding: 6px 12px; border-radius: 8px;
    background: var(--c-dark); color: #fff6e8; white-space: nowrap;
  }

  .filters { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px 8px; }
  .field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .field.search { grid-column: 1 / span 2; }
  .field.search + .field { grid-column-start: 1; } /* Filter in neue Zeile */
  .label { font-size: 11px; font-weight: 700; color: var(--c-dark); }
  .input {
    display: flex; align-items: center; justify-content: space-between; gap: 6px;
    padding: 7px 10px; border: 1px solid var(--c-border); border-radius: 8px;
    font-size: 11px; color: var(--c-text-muted); white-space: nowrap; overflow: hidden;
  }
  .placeholder { overflow: hidden; text-overflow: ellipsis; }
  .select svg { flex-shrink: 0; }

  .table-wrap { overflow-x: auto; }
  .table { min-width: 340px; font-size: 13px; }
  .row {
    display: grid; grid-template-columns: 0.9fr 0.9fr 1fr 1.3fr; gap: 8px;
    padding: 10px 4px; align-items: center; border-bottom: 1px solid #f6eddc;
  }
  .row:last-child { border-bottom: none; }
  .row.head {
    padding-block: 6px; color: var(--c-dark); font-weight: 700; font-size: 12px;
    border-bottom-color: var(--c-line);
  }
  .row span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .name { font-weight: 600; }
  .groups { color: var(--c-text-soft); }
  .pill {
    justify-self: start; font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 999px;
    background: var(--c-tint); color: var(--c-label);
  }
  .pill.passive { background: #f1ece4; color: #5a4a36; }

  @media (max-width: 600px) {
    .sidebar { display: none; }
    .backdrop { right: -12px; }
  }
</style>
