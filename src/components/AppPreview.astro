---
// Illustrative Vorschau der App (Beispieldaten, kein Screenshot).
import Icon from './Icon.astro';

const members = [
  { name: 'Anna Beck', register: 'Klarinette', status: 'Aktiv' },
  { name: 'Luca Frick', register: 'Trompete', status: 'Aktiv' },
  { name: 'Mia Kaiser', register: 'Querflöte', status: 'Passiv' },
  { name: 'Jonas Wolf', register: 'Schlagzeug', status: 'Aktiv' },
];
const menu = ['Übersicht', 'Mitglieder', 'Instrumente', 'Uniformen', 'Musiknoten'];
---
<div class="preview" role="img" aria-label="Vorschau der Vereinsordner-App mit einer Mitgliederliste">
  <div class="backdrop" aria-hidden="true"></div>

  <div class="window" aria-hidden="true">
    <div class="titlebar">
      <div class="dots"><span></span><span></span><span></span></div>
      <div class="url">app.vereinsordner.li</div>
    </div>
    <div class="body">
      <div class="sidebar">
        {menu.map((m) => <span class:list={{ active: m === 'Mitglieder' }}>{m}</span>)}
      </div>
      <div class="main">
        <div class="main-head">
          <span class="main-title">Mitglieder</span>
          <span class="new">+ Neues Mitglied</span>
        </div>
        <div class="search"><Icon name="search" size={14} /> Suchen …</div>
        <div class="table-wrap">
          <div class="table">
            <div class="row head"><span>Name</span><span>Register</span><span>Status</span></div>
            {members.map((m) => (
              <div class="row">
                <span class="name">{m.name}</span>
                <span>{m.register}</span>
                <span class:list={['pill', { passive: m.status === 'Passiv' }]}>{m.status}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .preview { flex: 1 1 520px; min-width: 0; position: relative; }
  .backdrop {
    position: absolute; top: -28px; right: -28px; width: 70%; height: 80%;
    border-radius: 32px; background: var(--c-tint);
  }
  .window {
    position: relative; border-radius: 16px; background: #fff; overflow: hidden;
    border: 1px solid var(--c-border); box-shadow: 0 24px 60px rgb(65 36 2 / 0.14);
  }
  .titlebar {
    display: flex; align-items: center; gap: 12px; padding: 12px 16px;
    background: #fbf4e8; border-bottom: 1px solid var(--c-border);
  }
  .dots { display: flex; gap: 6px; }
  .dots span { width: 10px; height: 10px; border-radius: 50%; background: #e2cfae; }
  .url {
    flex: 1; text-align: center; font-size: 12px; color: var(--c-text-muted);
    background: #fff; border: 1px solid var(--c-border); border-radius: 6px; padding: 4px 10px;
  }
  .body { display: flex; min-height: 340px; }
  .sidebar {
    width: 150px; flex-shrink: 0; background: var(--c-dark); color: var(--c-on-dark);
    padding: 18px 12px; display: flex; flex-direction: column; gap: 4px;
    font-size: 13px; font-weight: 600;
  }
  .sidebar span { padding: 8px 10px; border-radius: 8px; }
  .sidebar .active { background: var(--c-orange); color: var(--c-dark); }
  .main { flex: 1; min-width: 0; padding: 20px; display: flex; flex-direction: column; gap: 14px; }
  .main-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .main-title { font-size: 18px; font-weight: 800; color: var(--c-dark); }
  .new {
    font-size: 12px; font-weight: 700; padding: 6px 12px; border-radius: 8px;
    background: var(--c-dark); color: #fff6e8; white-space: nowrap;
  }
  .search {
    display: flex; align-items: center; gap: 8px; padding: 8px 12px;
    border: 1px solid var(--c-border); border-radius: 8px; font-size: 12px; color: var(--c-text-muted);
  }
  .table-wrap { overflow-x: auto; }
  .table { min-width: 300px; font-size: 13px; }
  .row {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px;
    padding: 10px 4px; align-items: center; border-bottom: 1px solid #f6eddc;
  }
  .row:last-child { border-bottom: none; }
  .row.head {
    padding-block: 6px; color: var(--c-text-muted); font-weight: 700; font-size: 11px;
    text-transform: uppercase; letter-spacing: 0.06em; border-bottom-color: var(--c-line);
  }
  .name { font-weight: 600; }
  .pill {
    justify-self: start; font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 999px;
    background: var(--c-tint); color: var(--c-label);
  }
  .pill.passive { background: #f1ece4; color: #5a4a36; }

  @media (max-width: 600px) {
    .sidebar { display: none; }
    .backdrop { right: -12px; }
  }
</style>
