---
const clubs = ['Musikvereine', 'Feuerwehren', 'Fussballvereine', 'Chöre', 'Turnvereine', 'Kulturvereine'];
---
<section id="vereine" class="band">
  <div class="container audience">
    <h2 class="audience-title">Für alle Vereine – vom kleinen Dorfverein bis zum grossen Verband</h2>
    <ul class="chips">
      {clubs.map((c) => <li class="chip">{c}</li>)}
      <li class="chip more">… und viele mehr</li>
    </ul>
  </div>
</section>

<style>
  .audience {
    display: flex; flex-direction: column; align-items: center; gap: 22px;
    padding-block: 56px; text-align: center;
  }
  .audience-title { font-size: 17px; font-weight: 700; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .chip {
    padding: 10px 18px; border-radius: 999px; background: #fff; border: 1px solid var(--c-border);
    font-weight: 600; font-size: 15px; color: var(--c-dark);
  }
  .chip.more { background: transparent; border-color: transparent; color: var(--c-label); }
</style>
