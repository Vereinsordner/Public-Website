---
import Icon from './Icon.astro';

const points = ['Persönliche Vorführung', 'Antworten auf die Fragen Ihres Vereins', 'Unverbindlich'];
---
<section id="preise" class="band">
  <div class="container section split">
    <div class="stack pricing-text">
      <span class="eyebrow">Preise</span>
      <h2 class="h2">Abos für kleine und grosse Vereine – bald verfügbar</h2>
      <p class="lead">
        Wir arbeiten an Abos in verschiedenen Stufen, damit jeder Verein nur bezahlt, was er wirklich
        braucht. Bis dahin zeigen wir Ihnen den Vereinsordner gerne persönlich.
      </p>
    </div>

    <div class="card pricing-card">
      <ul class="points">
        {points.map((p) => (
          <li><Icon name="check" size={20} strokeWidth={2.4} class="check" />{p}</li>
        ))}
      </ul>
      <a class="btn btn-primary btn-lg" href="#demo">Demo anfragen</a>
    </div>
  </div>
</section>

<style>
  .pricing-text { flex: 1 1 420px; }
  .pricing-card { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 22px; padding: 32px; }
  .points { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; color: var(--c-dark); }
  .points li { display: flex; gap: 10px; align-items: flex-start; }
  .points :global(.check) { color: var(--c-brown); flex-shrink: 0; margin-top: 2px; }
</style>
