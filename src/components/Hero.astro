---
import Icon from './Icon.astro';
import AppPreview from './AppPreview.astro';
import { SITE } from '../config';
---
<section class="container hero">
  <div class="hero-text">
    <span class="badge">Vereinsverwaltung, einfach gemacht</span>
    <h1>Ihr Verein.<br />Gut geordnet.</h1>
    <p class="hero-lead">
      Mitglieder, Instrumente, Uniformen und Musiknoten an einem Ort – übersichtlich, sicher und für
      Vereine jeder Grösse.
    </p>
    <div class="hero-cta">
      <a class="btn btn-primary btn-lg" href="#demo">
        Demo anfragen
        <Icon name="arrowRight" size={18} strokeWidth={2.2} />
      </a>
      <a class="btn btn-soft btn-lg" href="#funktionen">Funktionen ansehen</a>
    </div>
    <p class="hero-login">
      Schon dabei? <a href={SITE.appUrl}>Hier geht's zur Anmeldung</a>
    </p>
  </div>

  <AppPreview />
</section>

<style>
  .hero {
    display: flex; flex-wrap: wrap; align-items: center; gap: 56px;
    padding-top: clamp(48px, 8vw, 88px);
    padding-bottom: clamp(56px, 8vw, 96px);
  }
  .hero-text { flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .badge {
    align-self: flex-start; padding: 6px 14px; border-radius: 999px;
    background: var(--c-tint); color: var(--c-label); font-size: 14px; font-weight: 700;
  }
  h1 { font-size: clamp(42px, 6vw, 60px); line-height: 1.05; letter-spacing: -0.025em; }
  .hero-lead { font-size: 20px; color: var(--c-text-soft); max-width: 520px; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 8px; }
  .hero-login { font-size: 14px; color: var(--c-text-muted); }
  .hero-login a { font-weight: 700; }
</style>
